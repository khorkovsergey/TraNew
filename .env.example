# Copy to .env.local for development. Never commit real values.

# --- Required ---

# Postgres. On Railway the app uses ${{Postgres.DATABASE_URL}} (private network).
# Locally, use the DATABASE_PUBLIC_URL from the Postgres service.
DATABASE_URL=

# Signing key for sessions and tokens. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Public origin the auth endpoints are reached on.
BETTER_AUTH_URL=http://localhost:3000

# Master key for the wealth record. 32 bytes, base64, generated the same way.
# Losing it makes every encrypted field unreadable — there is no recovery path.
# Rotating it requires re-wrapping each user's data key.
WEALTH_ENCRYPTION_KEY=

# Canonical origin used for canonical/hreflang tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Voyager (the AI assistant) ---

# Claude API key. Without it Voyager still answers, but from the scripted scenario
# layer, and every answer is labelled "simulated answer" in the UI so nobody
# mistakes a canned reply for analysis. Set it and the same UI is served by the
# model — no code change.
ANTHROPIC_API_KEY=

# --- Email ---

# With a key set, messages are sent for real and the stub below is ignored.
RESEND_API_KEY=
EMAIL_FROM=TradingNew <noreply@tradingnew.space>

# Stub: "preview" stores messages in the database instead of sending them, readable
# at /dev/mailbox?key=... The tokens inside stay real, single-use and time-limited.
# Without a key that page 404s — it must never be an open list of recovery links.
EMAIL_TRANSPORT=preview
PREVIEW_MAILBOX_KEY=

# --- Social sign-in ---

# Real credentials. A provider appears only when both of its values are set, and
# real credentials always take precedence over the stub below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Stub: "stub" offers demo buttons that sign in to a fixed demo account per
# provider. It accepts no address from the request, so it cannot be aimed at
# someone else's account. Remove this once real credentials exist.
OAUTH_TRANSPORT=stub

# --- Optional: feature flags ---

# Set to "false" to hide the Wealth Hub behind a waitlist preview.
NEXT_PUBLIC_WEALTH_HUB=true

# Copy to .env.local for development. Never commit real values.

# --- Required ---

# Postgres. On Railway the app uses ${{Postgres.DATABASE_URL}} (private network).
# Locally, use the DATABASE_PUBLIC_URL from the Postgres service.
DATABASE_URL=

# Signing key for sessions and tokens. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Public origin the auth endpoints are reached on.
BETTER_AUTH_URL=http://localhost:3000

# Master key for the wealth record. 32 bytes, base64, generated the same way.
# Losing it makes every encrypted field unreadable — there is no recovery path.
# Rotating it requires re-wrapping each user's data key.
WEALTH_ENCRYPTION_KEY=

# Canonical origin used for canonical/hreflang tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (verification and password reset do not work without it) ---

RESEND_API_KEY=
EMAIL_FROM=TradingNew <noreply@tradingnew.space>

# --- Optional: social sign-in. Each provider appears only when both values are set ---

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- Optional: feature flags ---

# Set to "false" to hide the Wealth Hub behind a waitlist preview.
NEXT_PUBLIC_WEALTH_HUB=true
